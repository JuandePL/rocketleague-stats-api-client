{
  "name": "rocketleague-stats-api-client",
  "version": "0.1.0",
  "description": "Fully typed WebSocket client for the official Rocket League Stats API, with runtime type guards for every event and command.",
  "keywords": [
    "rocket-league",
    "rocketleague",
    "stats-api",
    "websocket",
    "overlay",
    "esports",
    "typescript"
  ],
  "author": "JuandePL",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/JuandePL/rocketleague-stats-api-client.git"
  },
  "homepage": "https://github.com/JuandePL/rocketleague-stats-api-client",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "fs/promises": false,
    "path": false,
    "node:fs/promises": false,
    "node:path": false
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
